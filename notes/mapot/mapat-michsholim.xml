<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>מקומות הטעות האפשריים בפקודות</title>
    <kv version="2" absolute="yes"/>
    <kvAspects>
      <kvAspect id="b1" name="סוג הטעות"/>
    </kvAspects>
    <kvSheets>
      <kvSheet id="s1" kind="start" name="התחלת נושא"/>
      <kvSheet id="s2" kind="free" name="סיעור מוחות"/>
      <kvSheet id="s3" kind="map" name="מפה" absolute="yes" body="yes"/>
    </kvSheets>
  </head>
  <body>
    <outline text="מקומות הטעות האפשריים בפקודות">
      <kvInfo kind="user" name="הגדרה">כאשר מחליטים כיוון מרגישים שהוא הנכון, ולאחר זמן מגיעים מזווית אחרת ואז חושבים שהיא הנכונה. ומכאן נוצרים כפילויות, סתירות וחוסר דיוקים</kvInfo>
      <kvInfo kind="user" name="הערה">ולכן צריך להתבונן על כל ההיקף. רושמים את מקומות המכשול כדי להיזהר לא ליפול בהם</kvInfo>
      <outline kvDivision="yes" text="סוג הטעות" kvAspect="b1">
        <outline text="בדבר עצמו — יש בו יותר ממה שנראה">
          <outline text="חלק שיש בו כמה היבטים">
            <kvInfo kind="user" name="הגדרה">לעיתים זה נראה ברור ולעיתים זה יותר גבולי. לעיתים באים מצד אחד והוא נראה העיקרי, ולעיתים מהצד השני והוא נראה עיקרי — בתקווה שאין צד שלישי</kvInfo>
            <outline text="מה קורה כשנופלים: כל צד בונה פקודות משלו, ואותו דבר מוגדר פעמיים, בשתי שפות"/>
            <outline text="דוגמאות">
              <outline text="המסד והאינדקס — חלק מהתוכנה, או המיכל והתרשים של החומר"/>
              <outline text="הכפולים — כלי במסכים, ותנאי ברשימה חכמה"/>
              <outline text="ההגדרות — של הרשימות (מהעיקריים), ושל התוכנה (משרתות)"/>
            </outline>
          </outline>
          <outline text="פעולה שנראית אחת, ויש לה כמה פנים וכמה עומקים">
            <outline text="דוגמה: העתק רשימה">
              <outline text="השם, או איזה חלק מהשם"/>
              <outline text="הקבצים, או השמות של הקבצים"/>
              <outline text="עד איזה עומק"/>
              <outline text="האם כולל את רשימות המשנה, הידניות והחכמות"/>
            </outline>
          </outline>
        </outline>
        <outline text="בשמות — מילה ומשמעות אינן אחת לאחת">
          <outline text="כמה פעלים דומים לאותה פעולה, או לפעולות דומות">
            <kvInfo kind="user" name="הגדרה">יש לאותן פעולות, או לפעולות דומות, אפשרות להתייחס בכמה פעלים דומים — ולעיתים דומים אבל מובחנים</kvInfo>
            <outline text="דוגמאות">
              <outline text="צור, פתח, הקם, בנה — כולם יכולים להתאים לרשימה"/>
              <outline text="העתק / הכפל — אותה פקודה"/>
              <outline text="מחק / בטל / מחק תיקייה / בטל אופן / רוקן סל"/>
              <outline text="פתח — גם להציג קיימת וגם לפתוח חדשה"/>
            </outline>
          </outline>
          <outline text="פועל אחד לפריטים דומים">
            <kvInfo kind="user" name="הגדרה">כאשר לפריטים דומים מייחסים פעולות דומות. צריך להתבונן אם זו אותה פעולה בדיוק, או שלעיתים יש הבחנות שונות בכל אחת — ולשקול אם לייחד לה פועל שונה, כדי להבחין בין גווני הפעולה</kvInfo>
            <kvInfo kind="user" name="הערה">מקום דומה, אם כי פחות מבלבל</kvInfo>
            <outline text="דוגמה: להעתיק קובץ, רשימה ידנית, רשימה חכמה, אופן או פקודה"/>
            <outline text="מה שכבר הובחן">
              <outline text="למחוק קובץ / להסיר מרשימה"/>
              <outline text="העתק / קשר"/>
            </outline>
            <outline text="מה שעוד לא: שני לוחות נפרדים — לקבצים ולרשימות"/>
          </outline>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
