<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tikiyot.vfm"
    android:versionCode="171"
    android:versionName="1.25.2">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="30" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- שליחה למכשיר (117): לראות אילו תוכנות מקבלות קבצים, כדי להציג רק את תוכנות ההעברה -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true" android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.Light.DarkActionBar">

        <activity android:name=".Home" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SearchScreen" android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity android:name=".VirtualScreen" android:exported="false" />
        <activity android:name=".DupScreen" android:exported="false" />
        <activity android:name=".TrashScreen" android:exported="false" />
        <activity android:name=".DiskScreen" android:exported="false" />
        <activity android:name=".AsIfScreen" android:exported="false" />
        <activity android:name=".SettingsScreen" android:exported="false" />
        <activity android:name=".IniListScreen" android:exported="false" />
        <activity android:name=".IniEditScreen" android:exported="false" />
        <activity android:name=".BatchEditScreen" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ShareScreen" android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.tikiyot.vfm.share"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service android:name=".BarService" android:exported="false" />
        <service android:name=".SigJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <provider android:name=".Provider"
            android:authorities="com.tikiyot.vfm.files"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
