הדמיה
REM בדיקת ממשק הפקודות 1.23.0. לעבור על כל שורה בתפריט שלמעלה: לבחור, לקרוא את ההסבר והפרמטרים, ולנסות ▶ הדמיה.
REM השורה הראשונה (הדמיה) — כל הקובץ רץ בכאילו, ושום דבר לא משתנה בכונן. הקובץ נמחק בגרסה הבאה.
ECHO מתחילים את הבדיקה
MD "%פנימי%\בדיקת-פקודות\א"
COPY "%הורדות%\*.pdf" "%פנימי%\בדיקת-פקודות\א" /תפוס:לדלג /תאריך:שנה
COPY "%פנימי%\Documents" "%פנימי%\בדיקת-פקודות\ב" /S /יומן:"%פנימי%\בדיקת-פקודות\יומן.txt"
MOVE "%פנימי%\בדיקת-פקודות\א\*.pdf" "%פנימי%\בדיקת-פקודות\ג" /גודל:>1MB
REN "%פנימי%\בדיקת-פקודות\קובץ.txt" חדש.txt
COMP "%פנימי%\בדיקת-פקודות\א" "%פנימי%\בדיקת-פקודות\ב"
COPY %רק-במקור% "%פנימי%\בדיקת-פקודות\ב" /תפוס:לעצור
MOVE %רק-ביעד% "%פנימי%\בדיקת-פקודות\היסטוריה\%תאריך%" /עד:20%
COMP /רשימה:גיבוי "%פנימי%\בדיקת-פקודות\גיבוי"
DEL "%פנימי%\בדיקת-פקודות\*.tmp"
RD "%פנימי%\בדיקת-פקודות\ריקה"
RD "%פנימי%\בדיקת-פקודות\ג" /S
COPY "%פנימי%\גיבוי" "%פנימי%\בדיקת-פקודות\שחזור" /מצב:"28.10.2026"
START "%פנימי%\בדיקת-פקודות"
פתח מסך חיפוש
מצא סוג:ספרים
