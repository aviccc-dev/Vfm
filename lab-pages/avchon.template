<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="vfm-plugin" content="אבחון">
<meta name="vfm-plugin-version" content="/*VERSION*/">
<title>אבחון</title>
<style>
/* תוסף "אבחון" (מ0.42): הבדיקות, הדוחות והתקלות — מה שהיה ב־⋮ ובהגדרות (claude/tosaf-bdikot.md).
   הבדיקות עצמן — קובצי פקודות שרצים במסך ההרצה; התוצאה חוזרת בקובץ "דוח" שהעמוד קורא. נבנה מ־avchon.template (avchon-build.py). */
:root{
  --bg:#FFFFFF; --soft:#F4F5F6; --fg:#202124; --muted:#5F6368; --ghost:#9AA0A6; --chip:#E8F0FE; --chip-fg:#174EA6;
  --accent:#1A73E8; --err:#C5221F; --ok:#188038; --warn:#B06000; --rule:#E0E0E0; --on:#FFFFFF; --shade:rgba(32,33,36,.38);
  --f:system-ui,"Roboto","Noto Sans Hebrew",Arial,sans-serif; --mono:ui-monospace,"Roboto Mono",monospace;
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--f);font-size:16px;line-height:1.5}
body{padding-bottom:calc(24px + env(safe-area-inset-bottom,0px))}
.top{position:sticky;top:0;z-index:5;background:var(--soft);border-bottom:1px solid var(--rule)}
.head{padding:10px 14px 2px}
.head h1{margin:0;font-size:1.15rem}
.head .sub{color:var(--muted);font-size:.82rem}
.tabs{display:flex;gap:4px;padding:6px 10px 8px;overflow-x:auto}
.tabs button{font:inherit;font-size:.9rem;border:1px solid var(--rule);background:var(--bg);color:var(--muted);border-radius:18px;padding:5px 13px;white-space:nowrap;cursor:pointer}
.tabs button.on{background:var(--chip);color:var(--chip-fg);border-color:var(--chip);font-weight:600}
main{padding:10px 12px;max-width:760px;margin:0 auto}
.card{border:1px solid var(--rule);border-radius:10px;padding:10px 12px;margin:0 0 10px;background:var(--bg)}
.card h2{margin:0;font-size:1rem;display:flex;gap:8px;align-items:center}
.card h2 .grow{flex:1}
.card p{margin:4px 0;color:var(--muted);font-size:.86rem}
.st{font-size:.88rem;margin-top:6px}
.st.ok{color:var(--ok)} .st.bad{color:var(--err)} .st.wait{color:var(--warn)} .st.none{color:var(--ghost)}
.btn{font:inherit;font-size:.92rem;border-radius:8px;border:1px solid var(--rule);background:var(--bg);color:var(--fg);padding:6px 12px;cursor:pointer;white-space:nowrap}
.btn.main{background:var(--accent);border-color:var(--accent);color:var(--on)}
.btn.warn{border-color:var(--err);color:var(--err)}
.btn:disabled{opacity:.45;cursor:default}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:8px}
.lines{margin:6px 0 0;padding:6px 8px;background:var(--soft);border-radius:8px;font-family:var(--mono);font-size:.76rem;white-space:pre-wrap;word-break:break-word;max-height:240px;overflow:auto;direction:rtl;text-align:start}
.kv{display:grid;grid-template-columns:auto 1fr;gap:2px 10px;font-size:.88rem}
.kv b{font-weight:500;color:var(--muted)}
select,input[type=text]{font:inherit;font-size:.92rem;border:1px solid var(--rule);border-radius:8px;padding:6px 8px;background:var(--bg);color:var(--fg);max-width:100%}
input[type=text]{width:100%;direction:ltr;text-align:left}
.seg{display:inline-flex;border:1px solid var(--rule);border-radius:8px;overflow:hidden}
.seg button{font:inherit;font-size:.82rem;border:0;background:var(--bg);color:var(--muted);padding:4px 10px;cursor:pointer}
.seg button+button{border-inline-start:1px solid var(--rule)}
.seg button.on{background:var(--chip);color:var(--chip-fg);font-weight:600}
.log .e{border-bottom:1px solid var(--rule);padding:5px 0}
.log .e:last-child{border-bottom:0}
.log .d{color:var(--ghost);font-size:.74rem}
.log .t{font-family:var(--mono);font-size:.78rem;white-space:pre-wrap;word-break:break-word}
.log .e.err .t{color:var(--err)}
.note{font-size:.84rem;color:var(--muted);margin:6px 2px 12px}
.banner{position:fixed;inset-inline:12px;bottom:calc(14px + env(safe-area-inset-bottom,0px));background:var(--fg);color:var(--bg);border-radius:10px;padding:10px 14px;font-size:.9rem;z-index:20;display:none}
.banner.err{background:var(--err);color:var(--on)}
#shade{position:fixed;inset:0;background:var(--shade);display:none;z-index:30}
#sheet{position:fixed;inset-inline:0;bottom:0;max-height:88vh;background:var(--bg);border-radius:14px 14px 0 0;display:none;z-index:31;flex-direction:column}
#sheet .sh{display:flex;gap:8px;align-items:center;padding:10px 12px;border-bottom:1px solid var(--rule)}
#sheet .sh b{flex:1}
#sheet pre{margin:0;padding:10px 12px;overflow:auto;font-family:var(--mono);font-size:.76rem;white-space:pre-wrap;word-break:break-word;flex:1}
</style>
</head>
<body>
<div class="top">
  <div class="head"><h1>🔬 אבחון</h1><div class="sub" id="sub"></div></div>
  <div class="tabs" id="tabs">
    <button data-t="tests">🧪 בדיקות</button><button data-t="db">🗄 מסדים</button><button data-t="report">📄 דוח</button><button data-t="log">⚠ יומן תקלות</button><button data-t="index">🗂 אינדקס</button>
  </div>
</div>
<main id="main"></main>
<div class="banner" id="banner"></div>
<div id="shade"></div>
<div id="sheet"><div class="sh"><b id="shT"></b><button class="btn" id="shSend">שליחה</button><button class="btn" id="shX">סגירה</button></div><pre id="shP"></pre></div>
<script type="application/json" id="tests">/*TESTS*/</script>
<script>
(function(){
"use strict";
// ---------- הגשר לתוכנה (בדפדפן רגיל — דוגמה, לבדיקה) ----------
const pending={};let seq=0;
window.vfmResult=function(id,v){const cb=pending[id];delete pending[id];if(cb)cb(v);};
const V=window.vfm||demoBridge();
const can=n=>typeof V[n]==='function';
function ask(method,args,cb){const id='r'+(++seq);pending[id]=cb;V[method].apply(V,[id].concat(args));}
function J(s,d){try{return s==null||s===''?d:JSON.parse(s);}catch(e){return d;}}
function pref(k,d){try{const v=V.load(k);return v==null?d:v;}catch(e){return d;}}
function setPref(k,v){try{V.save(k,v);}catch(e){}}
const $=id=>document.getElementById(id);
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
let bannerT=0;
function say(s,err){const b=$('banner');b.textContent=s;b.className='banner'+(err?' err':'');b.style.display='block';clearTimeout(bannerT);bannerT=setTimeout(()=>{b.style.display='none';},err?7000:3500);}
function fail(where,e){const m=where+': '+(e&&e.message?e.message:e);try{V.log(m);}catch(x){}say('⚠ '+m,true);}   // תקלה — תמיד נראית, וגם ביומן
function when(t){if(!t)return'—';const d=new Date(t),p=n=>(n<10?'0':'')+n;return p(d.getDate())+'.'+p(d.getMonth()+1)+'.'+d.getFullYear()+' '+p(d.getHours())+':'+p(d.getMinutes());}

// ---------- מה שהתוכנה מספרת ----------
const NEED=['dataDir','saveText','runFile','readText','pathInfo','send'];   // מ0.42
const ready=NEED.every(can);
let info={};
function loadInfo(){info=J(can('info')?V.info():null,{});info.model=String(info.device||'').replace(/^[^·]*·\s*/,'');}   // device: גרסה · יצרן דגם · אנדרואיד
loadInfo();
const TESTS=J($('tests').textContent,{});
const TEST_MODE='בדיקות מערכת',MENUS_MODE='שמור לתוכנה',EXAMPLES='דוגמאות',REAL='%האופן-האמיתי%',MARK='הרצת אבחון ';
// הקבצים שהבדיקות מפנות אליהם בשם (כלול, העתקה של קובץ הבדיקה עצמו) — נכתבים לתיקייה של התוסף לפני כל הרצה
const FILES={'בדיקת פקודות.vbat':'pkudot-masad','בדיקת כלול.vbat':'pkudot-kalul','בדיקת מ0.23.vbat':'gersa-023','בדיקת מ0.24.vbat':'gersa-024',
  'בדיקה כללית.vbat':'klali','בדיקת לחץ.vbat':'lachatz','בדיקת שני אופנים.vbat':'shney-ofanim','בדיקת עומס.vbat':'omes-masad'};
// הקבוצות. clean — הרשימות שהקבוצה יוצרת, לפי אופן: מבוטלות בסוף ההרצה (המשתמש: "סתם מצטבר שם שאריות")
const GROUPS=[
  {k:'general',n:'כללית',d:'כל הפונקציות: רשימות במסד, קבצים בכונן, חכמות, יצוא וייבוא, תפריטים — וגם מה שחדש בגרסה. כשתי דקות.',
    inc:['בדיקה כללית.vbat'],clean:[[TEST_MODE,['בדיקת פקודות','בדיקת מעקב','בדיקת מ0.24','בדיקת מ0.37','בדיקת מ0.40','בדיקת מ0.41']]]},
  {k:'stress',n:'לחץ',d:'מנסה לסבך: שמות זהים ברמות שונות, שרשרת העתקה ← שינוי שם ← העברה, קישור ומחיקה.',
    inc:['בדיקת לחץ.vbat'],clean:[[TEST_MODE,['בדיקת לחץ']]]},
  {k:'modes',n:'שני אופנים',d:'קובץ אחד שעובד בשני אופנים ("בדיקות מערכת" ו"דוגמאות"), וכל רשימה נרשמת באופן שלה.',
    inc:['בדיקת שני אופנים.vbat'],clean:[[TEST_MODE,['בדיקת-אופן-א']],[EXAMPLES,['בדיקת-אופן-ב']]]},
  {k:'db',n:'המסד',d:'המנוע של המסד מול ה־SQLite של המכשיר (על מסדים זמניים), ותקינות המסד של כל אופן. לא משנה דבר.',
    lines:['ודא מסד'],clean:[]},
  {k:'index',n:'אינדקס',d:'רענון מהיר ורענון עמוק, עם זמן לכל שורה; קובץ חדש — האינדקס מכיר אותו.',
    lines:['רענן','רענן עמוק','צור תיקייה "%פנימי%\\בדיקת אינדקס (אפשר למחוק)"','כתוב "%פנימי%\\בדיקת אינדקס (אפשר למחוק)\\א.txt" "אינדקס"',
      'ודא "%פנימי%\\בדיקת אינדקס (אפשר למחוק)\\א.txt" באינדקס','מחק תיקייה "%פנימי%\\בדיקת אינדקס (אפשר למחוק)" /עמוק',
      'ודא "%פנימי%\\בדיקת אינדקס (אפשר למחוק)" חסר'],clean:[]},
  {k:'rebuild',n:'בניית האינדקס מחדש',heavy:true,d:'בונה את האינדקס מההתחלה, בכל הכוננים, עם מדידת זמן (מה שהיה הכפתור בהגדרות). קובץ שנכתב לפני — נמצא אחרי. בזמן הבנייה החיפוש איטי.',
    lines:['צור תיקייה "%פנימי%\\בדיקת בנייה (אפשר למחוק)"','כתוב "%פנימי%\\בדיקת בנייה (אפשר למחוק)\\א.txt" "בנייה"','רענן מלא',
      'ודא "%פנימי%\\בדיקת בנייה (אפשר למחוק)\\א.txt" באינדקס','מחק תיקייה "%פנימי%\\בדיקת בנייה (אפשר למחוק)" /עמוק'],clean:[]},
  {k:'load',n:'עומס',heavy:true,d:'על הנתונים האמיתיים של האופן שנבחר: מעתיק את כל מה שבבית לרשימה "בדיקת עומס" ומכפיל אותה 3 סבבים, עם מדידת זמן. המקור לא נוגע; בסוף הרשימה מבוטלת.',
    inc:['בדיקת עומס.vbat'],clean:[[REAL,['בדיקת עומס']]]}
];
let results=J(pref('results',null),{});
function saveResults(){setPref('results',JSON.stringify(results));}

// ---------- הרצה ----------
function modesList(){return J(can('modes')?V.modes():null,[]);}
function realModes(){return modesList().filter(m=>m!==TEST_MODE&&m!==MENUS_MODE);}
function realMode(){const ms=realModes(),p=pref('real',''),s=info.savedMode||'';
  return ms.indexOf(p)>=0?p:ms.indexOf(s)>=0?s:ms.length?ms[0]:TEST_MODE;}
function dataDir(){return V.dataDir();}
function resultPath(key){return dataDir()+'/תוצאות/'+key+'.txt';}

function runner(id,label,gs,real){
  const L=['בדיקה','המשך ()','מדידה','דוח "'+resultPath(gs.length===1?gs[0].k:'all')+'"',
    'ECHO '+MARK+id+' · '+label+' · גרסה '+(info.version||'?')+' · '+when(Date.now()),
    ':: אופן הבדיקות — נוצר אם אין (מ0.42: "צור אופן")','צור אופן "'+TEST_MODE+'"'];
  gs.forEach(g=>{L.push(':: '+g.n);(g.inc||[]).forEach(f=>L.push('כלול "'+f+'"'));(g.lines||[]).forEach(x=>L.push(x));});
  const by={},order=[];
  gs.forEach(g=>g.clean.forEach(c=>{const m=c[0]===REAL?real:c[0];if(!by[m]){by[m]=[];order.push(m);}c[1].forEach(x=>{if(by[m].indexOf(x)<0)by[m].push(x);});}));
  if(order.length)L.push(':: ניקוי — הרשימות שהבדיקה יצרה, כל אחת מהאופן שלה; ואז רישומי הקבצים שנשארו בלי רשימה באופן הבדיקות');
  order.forEach(m=>{L.push('אופן "'+m+'"');by[m].forEach(x=>{L.push('בטל ידנית "'+x+'"');L.push('ודא ידנית "'+x+'" חסרה');});});
  if(by[TEST_MODE]){if(order[order.length-1]!==TEST_MODE)L.push('אופן "'+TEST_MODE+'"');L.push('בטל לא-משויכים','ודא לא-משויכים /פריטים:0');}
  return L.join('\n')+'\n';
}

function writeFiles(real){
  for(const name in FILES){
    let t=TESTS[FILES[name]];
    if(t==null)throw new Error('חסר בעמוד: '+name);
    t=t.split(REAL).join(real);
    if(!V.saveText(name,t,false))throw new Error('לא נכתב: '+name+' (הפרטים ביומן)');
  }
}

function run(gs,label){
  if(!ready){say('התוסף צריך את מ0.42 של התוכנה ומעלה',true);return;}
  try{
    const real=realMode(),id=Date.now().toString(36);
    writeFiles(real);
    const key=gs.length===1?gs[0].k:'all';
    const text=runner(id,label,gs,real);
    setPref('pending',JSON.stringify({id:id,key:key,label:label,groups:gs.map(g=>g.k),path:resultPath(key),at:Date.now()}));
    V.runFile(text,dataDir()+'/אבחון — '+label+'.vbat',true);
    render();
  }catch(e){fail('הרצה',e);}
}

function parse(t){
  const lines=t.split('\n'),bad=[],warn=[];let sum=null;
  lines.forEach(l=>{const m=l.match(/ודא: (\d+) עברו · (\d+) נכשלו/);if(m){sum=[+m[1],+m[2]];return;}
    // רק שורות של הדוח ("שורה 12: …") — ההודעות (ECHO) בראש הקובץ מסבירות "✅ או ❌", ואינן כישלון (גרסה 3)
    if(/^שורה [^:]+: ❌/.test(l))bad.push(l);else if(/^שורה [^:]+: .*⚠|^שום שורה לא רצה/.test(l))warn.push(l);});
  const blocked=t.indexOf('שום שורה לא רצה')>=0;
  return {ok:sum?sum[0]:0,bad:sum?sum[1]:bad.length,badLines:bad.slice(0,80),warn:warn.slice(0,40),blocked:blocked};
}

/** חזרה לעמוד (ממסך ההרצה): הקובץ של ה"דוח" — עם המזהה של ההרצה הזו, רק אם היא הסתיימה. */
function collect(){
  const p=J(pref('pending',null),null);if(!p)return;
  const t=V.readText(p.path);
  if(t==null||t.indexOf(MARK+p.id)<0)return;              // בוטלה, או עוד לא הסתיימה
  const r=parse(t);r.at=Date.now();r.version=info.version;r.label=p.label;r.path=p.path;r.groups=p.groups;
  results[p.key]=r;
  if(p.key==='all'&&!r.blocked&&r.bad===0)p.groups.forEach(k=>{results[k]={ok:0,bad:0,badLines:[],warn:[],at:r.at,version:r.version,label:r.label,path:r.path,inAll:true};});
  saveResults();setPref('pending','');
  say(r.blocked?'⚠ הקובץ לא רץ — שגיאות בקובץ (פרטים בכרטיס)':r.bad?'❌ '+r.bad+' נכשלו · '+r.ok+' עברו':'✅ '+r.ok+' עברו, בלי כישלון',!!(r.blocked||r.bad));
}
window.vfmResume=function(){try{loadInfo();collect();render();}catch(e){fail('חזרה',e);}};

// ---------- המסכים ----------
let tab=pref('tab','tests');
function setTab(t){tab=t;setPref('tab',t);render();window.scrollTo(0,0);}
$('tabs').addEventListener('click',e=>{const b=e.target.closest('button');if(b)setTab(b.dataset.t);});

function status(k){
  const p=J(pref('pending',null),null),r=results[k];
  if(p&&p.groups&&p.groups.indexOf(k)>=0&&(p.key===k||p.key==='all'))return '<div class="st wait">⏳ ממתין לתוצאה של ההרצה מ־'+when(p.at)+' — אם היא בוטלה, אפשר להריץ שוב</div>';
  if(!r)return '<div class="st none">עוד לא הורץ</div>';
  const old=r.version!==info.version?' · <b>בגרסה '+esc(r.version)+' — לא בגרסה הזו</b>':'';
  if(r.inAll)return '<div class="st ok">✅ עבר בהרצת "הכול" · '+when(r.at)+old+'</div>';
  if(r.blocked)return '<div class="st bad">⚠ לא רץ — שגיאות בקובץ · '+when(r.at)+old+'</div>'+lines(r.warn);
  const cls=r.bad?'bad':'ok';
  return '<div class="st '+cls+'">'+(r.bad?'❌ '+r.bad+' נכשלו · ':'✅ ')+r.ok+' עברו · '+when(r.at)+old+'</div>'+lines(r.badLines.concat(r.warn));
}
function fullBtn(k){const r=results[k];return r&&r.path?'<button class="btn" data-a="show" data-p="'+esc(r.path)+'" data-n="'+esc(r.label||'')+'">הדוח המלא</button>':'';}
function lines(a){return a&&a.length?'<div class="lines">'+esc(a.join('\n'))+'</div>':'';}

function renderTests(){
  const ms=realModes(),rm=realMode();
  let h='';
  if(!ready)h+='<div class="card"><h2>⚠ גרסה ישנה של התוכנה</h2><p>התוסף צריך את מ0.42 ומעלה (היא מכירה "צור אופן", "ודא מסד" ומחזירה את התוצאה לעמוד). בגרסה הזו — ⋮ ← "בדיקת הפקודות" ו"דוח אבחון".</p></div>';
  h+='<p class="note">כל הרצה — במסך ההרצה: מה יקרה, אישור, ובסוף חוזרים לכאן והתוצאה נקראת. הבדיקות רצות באופן "'+TEST_MODE+'" (נוצר בהרצה הראשונה), והרשימות שהן יוצרות מבוטלות בסוף.</p>';
  h+='<div class="card"><h2><span class="grow">▶ הכול</span></h2><p>כל הקבוצות בהרצה אחת, עם ניקוי בסוף. "בלי הכבדות" — בלי העומס ובלי בניית האינדקס מחדש. העומס — על האופן שנבחר בכרטיס שלו.</p>'
    +status('all')+'<div class="row"><button class="btn main" data-a="run" data-k="all"'+(ready?'':' disabled')+'>▶ הרץ הכול</button>'
    +'<button class="btn" data-a="run" data-k="light"'+(ready?'':' disabled')+'>▶ הכול בלי הכבדות</button>'+fullBtn('all')+'</div></div>';
  GROUPS.forEach(g=>{
    h+='<div class="card"><h2><span class="grow">'+esc(g.n)+'</span></h2><p>'+esc(g.d)+'</p>'+status(g.k);
    if(g.k==='load')h+='<div class="row">על האופן: <select id="realSel">'+ms.map(m=>'<option'+(m===rm?' selected':'')+'>'+esc(m)+'</option>').join('')+'</select></div>';
    h+='<div class="row"><button class="btn'+(g.heavy?' warn':'')+'" data-a="run" data-k="'+g.k+'"'+(ready?'':' disabled')+'>▶ הרץ</button>'+fullBtn(g.k)+'</div></div>';
  });
  h+='<p class="note">בדיקות חדשות מגיעות עם גרסה חדשה של התוסף — בלי התקנה של התוכנה. התוצאות נשמרות בתיקייה "נתוני תוספים/אבחון/תוצאות".</p>';
  return h;
}

function trialText(){
  const t=info.trial?V.readText(info.trial):null;
  const ls=(t||'').split('\n').map(x=>x.trim()).filter(Boolean);
  const kinds=['מה השתנה מאז','יומית','שבועית'],s={};kinds.forEach(k=>s[k]=[0,0,0]);
  ls.forEach(l=>{const p=l.split(' | ');if(p.length<5)return;const k=p[1].trim(),m=p[p.length-1].match(/(\d+)/);if(!s[k]||!m)return;const n=+m[1];s[k][0]++;s[k][1]+=n;if(n>0)s[k][2]++;});
  let out='';
  if(info.pointsSupported===false)out+='באנדרואיד הזה אין "מה השתנה מאז" — במקומו בנייה מלאה פעם ביום.\n';
  if(!ls.length)out+='עוד לא נרשם דבר. הבדיקה היומית רצה פעם ביום, והבנייה השבועית — פעם בשבוע.\n';
  else{out+='מ־'+ls[0].split(' ')[0]+':\n';kinds.forEach(k=>{const v=s[k];out+='• '+k+': רצה '+v[0]+' פעמים, מצאה משהו '+v[2]+' · נמצאו '+v[1]+' קבצים\n';});}
  out+='בנייה מלאה אחרונה: '+when(info.lastFullBuild)+' · בדיקה יומית אחרונה: '+(info.lastDaily?when(info.lastDaily):'עוד לא')+'\n';
  if(ls.length)out+='\nהאחרונות:\n'+ls.slice(-15).join('\n')+'\n';
  return out;
}

function header(){
  const ms=modesList();
  return 'גרסה: '+(info.version||'?')+' ('+(info.versionCode||'?')+') · '+(info.model||'')+'\n'
    +'הרשאת גישה לכל הקבצים: '+(info.access?'✓':'✗')+' · מקום פנוי: '+(info.freeMb!=null?info.freeMb+'MB':'?')+'\n'
    +'האופן השמור: '+(info.savedMode||'?')+' · האופנים: '+ms.join(', ')+'\n'
    +'האינדקס: '+(info.indexReady?'מוכן':'נטען')+'\n';
}

function fullReport(){
  let out='דוח אבחון (תוסף אבחון '+(info.labVersion||'')+') · '+when(Date.now())+'\n'+header();
  out+='\n=== הבדיקות ===\n';
  let latest=null;
  [{k:'all',n:'הכול'}].concat(GROUPS).forEach(g=>{const r=results[g.k];
    if(!r){out+=g.n+': עוד לא הורץ\n';return;}
    if(!latest||r.at>latest.at)latest=r;
    out+=g.n+': '+(r.inAll?'✅ עבר בהרצת "הכול"':r.blocked?'⚠ לא רץ — שגיאות בקובץ':(r.bad?'❌ '+r.bad+' נכשלו · ':'✅ ')+r.ok+' עברו')+' · '+when(r.at)+' · גרסה '+r.version+'\n';
    (r.badLines||[]).concat(r.warn||[]).forEach(l=>out+='   '+l+'\n');});
  if(latest&&latest.path){const t=V.readText(latest.path);if(t)out+='\n=== הדוח המלא של ההרצה האחרונה ('+latest.label+') ===\n'+t+'\n';}
  out+='\n=== המסדים ===\n'+dbs().map(dbLine).join('\n')+'\n';
  out+='\n=== האינדקס ===\n'+indexText();
  out+='\n=== תקופת הניסיון של האינדקס ===\n'+trialText();
  const log=info.log?V.readText(info.log):null;
  const es=log?logEntries(log):[],errs=es.filter(isErr);
  out+='\n=== יומן התקלות — התקלות האחרונות ('+errs.length+' מתוך '+es.length+' רשומות) ===\n'
    +(errs.length?errs.slice(-30).map(e=>e.d+'  '+(e.t.length>1500?e.t.slice(0,1500)+'…':e.t)).join('\n'):'אין תקלות')+'\n';
  out+='\n=== היומן — 25 הרשומות האחרונות ===\n'+(es.length?es.slice(-25).map(e=>e.d+'  '+(e.t.length>400?e.t.slice(0,400)+'…':e.t)).join('\n'):'ריק')+'\n';
  return out;
}

function renderReport(){
  return '<div class="card"><h2>📄 דוח מלא</h2><p>המכשיר והגרסה, התוצאה של כל קבוצת בדיקות (וכל ❌), הדוח המלא של ההרצה האחרונה, המסדים, האינדקס, תקופת הניסיון, וסוף יומן התקלות — בקובץ אחד בהורדות.</p>'
    +'<div class="row"><button class="btn main" data-a="report"'+(ready?'':' disabled')+'>שמירה בהורדות ושליחה</button><button class="btn" data-a="preview">הצגה</button></div></div>'
    +'<div class="card"><h2>המכשיר</h2><div class="lines">'+esc(header())+'</div></div>';
}

// ---------- המסדים (מה שהיה בחלק 2 של דוח האבחון) ----------
function dbs(){return J(can('dbStats')?V.dbStats():null,[]);}
function dbLine(d){return d.mode+': '+(d.ok===false?'✗ פגום ('+(d.error||'')+')':'✓ תקין · רשימות '+d.lists+' · חכמות '+d.smarts+' · בבית '+(d.home<0?'— (אין בית)':d.home)+' · לא־משויכים '+d.loose)
  +' · '+d.kb+'KB · גיבויים '+d.backups+(d.lastBackup?' (האחרון: '+d.lastBackup+')':'');}
function renderDb(){
  if(!can('dbStats'))return '<p class="note">התוכנה בגרסה הזו לא מוסרת את מצב המסדים (צריך מ0.43).</p>';
  const ds=dbs();
  let h='<p class="note">המסד של כל אופן: תקינות, כמה רשימות וחכמות, וכמה קבצים רשומים בו בלי להיות באף רשימה ("לא־משויכים" — הקבצים בכונן לא נוגעים בהם). לקריאה בלבד; ביטול — דרך מסך ההרצה.</p>';
  ds.forEach(d=>{
    h+='<div class="card"><h2><span class="grow">'+esc(d.mode)+'</span><small>'+d.kb+'KB</small></h2>';
    if(d.ok===false)h+='<div class="st bad">✗ פגום: '+esc(d.error||'')+' — לשחזר מגיבוי (הגדרות ← גיבויים)</div>';
    else h+='<div class="kv"><b>תקינות</b><span>✓ תקין</span><b>רשימות</b><span>'+d.lists+'</span><b>חכמות</b><span>'+d.smarts+'</span><b>בבית</b><span>'+(d.home<0?'אין בית':d.home+' פריטים')+'</span>'
      +'<b>לא־משויכים</b><span'+(d.loose>0?' style="color:var(--warn)"':'')+'>'+d.loose+'</span><b>גיבויים</b><span>'+d.backups+(d.lastBackup?' · '+esc(d.lastBackup):'')+'</span></div>';
    if(d.ok!==false&&d.loose>0)h+='<div class="row"><button class="btn" data-a="loose" data-m="'+esc(d.mode)+'"'+(ready?'':' disabled')+'>בטל לא־משויכים ('+d.loose+')</button></div>';
    h+='</div>';});
  return h;
}
function cleanLoose(m){
  const t='בדיקה\nאופן "'+m+'"\nבטל לא-משויכים\nודא לא-משויכים /פריטים:0\n';
  V.runFile(t,dataDir()+'/בטל לא-משויכים — '+m+'.vbat',true);
}
function indexText(){
  if(!info.indexReady)return 'האינדקס נטען…\n';
  let out='באינדקס: '+info.totalFiles+' קבצים · '+info.totalDirs+' תיקיות · עודכן: '+when(info.lastBuilt)+'\n';
  (info.indexes||[]).forEach(x=>out+='· '+x.label+': '+x.files+' קבצים\n');
  if(info.indexStatus)out+=info.indexStatus+'\n';
  return out;
}

let logMode=pref('logMode','err');
function logEntries(t){
  const out=[];let cur=null;
  t.split('\n').forEach(l=>{const m=l.match(/^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)  (.*)$/);
    if(m){cur={d:m[1],t:m[2]};out.push(cur);}else if(cur&&l.trim())cur.t+='\n'+l;});
  return out;
}
function isErr(e){return /^(שגיאה ב|קריסה)/.test(e.t);}
function renderLog(){
  const t=info.log?V.readText(info.log):null;
  const es=t?logEntries(t):[];
  const shown=(logMode==='err'?es.filter(isErr):es).slice(-200).reverse();
  let h='<div class="card"><h2><span class="grow">⚠ יומן התקלות</span><span class="seg"><button data-a="logm" data-m="err" class="'+(logMode==='err'?'on':'')+'">תקלות</button><button data-a="logm" data-m="all" class="'+(logMode==='all'?'on':'')+'">הכול</button></span></h2>'
    +'<p>'+es.length+' רשומות · '+es.filter(isErr).length+' תקלות. היומן מקצר את עצמו (נשאר הסוף).</p>'
    +'<div class="row"><button class="btn" data-a="sendlog"'+(t?'':' disabled')+'>שליחת היומן</button></div></div>';
  if(!t)return h+'<p class="note">היומן ריק'+(info.log?'':' (התוכנה לא מסרה איפה הוא)')+'.</p>';
  h+='<div class="card log">'+(shown.length?shown.map(e=>'<div class="e'+(isErr(e)?' err':'')+'"><div class="d">'+esc(e.d)+'</div><div class="t">'+esc(e.t.length>3000?e.t.slice(0,3000)+'…':e.t)+'</div></div>').join(''):'<p>אין תקלות ביומן.</p>')+'</div>';
  return h;
}

let lastPath=pref('path','');
function renderIndex(){
  return '<div class="card"><h2>האינדקס</h2><div class="lines">'+esc(indexText())+'</div><p>בדיקה עם זמנים — בלשונית "בדיקות": "אינדקס", ו"בניית האינדקס מחדש".</p></div>'
    +'<div class="card"><h2>בדיקת מסלול</h2><p>האם הקובץ בכונן, והאם האינדקס מכיר אותו. בקובץ פקודות: ודא "&lt;קובץ&gt;" באינדקס.</p>'
    +'<input type="text" id="pathIn" placeholder="/storage/emulated/0/Download/..." value="'+esc(lastPath)+'">'
    +'<div class="row"><button class="btn main" data-a="path">בדיקה</button>'+(can('pickFile')?'<button class="btn" data-a="pick">בחירת קובץ…</button>':'')+'</div><div id="pathOut"></div></div>'
    +'<div class="card"><h2>תקופת הניסיון</h2><p>מה שהבדיקה היומית, הבנייה השבועית ו"מה השתנה מאז" מצאו מעבר לבדיקה השוטפת.</p><div class="lines">'+esc(trialText())+'</div></div>';
}

function checkPath(){
  const v=($('pathIn').value||'').trim();if(!v)return;
  lastPath=v;setPref('path',v);
  const r=J(V.pathInfo(v),{});
  $('pathOut').innerHTML='<div class="kv" style="margin-top:8px"><b>בכונן</b><span>'+(r.disk?(r.dir?'תיקייה קיימת':'קיים · '+r.size+' בתים'):'לא נמצא')+'</span><b>באינדקס</b><span>'+(r.index?'✓ נמצא':'✗ לא נמצא')+'</span></div>'
    +(r.disk&&!r.index&&!r.dir?'<p>כדאי "רענון מהיר" (הגדרות), או בקובץ פקודות: רענן.</p>':'');
}

function render(){
  document.querySelectorAll('#tabs button').forEach(b=>b.classList.toggle('on',b.dataset.t===tab));
  $('sub').textContent=(info.version?'גרסה '+info.version+' · ':'')+(info.model||'')+(info.access===false?' · ✗ אין הרשאה לכל הקבצים':'');
  try{$('main').innerHTML=tab==='report'?renderReport():tab==='log'?renderLog():tab==='index'?renderIndex():tab==='db'?renderDb():renderTests();}
  catch(e){$('main').innerHTML='';fail('הצגה',e);}
}

$('main').addEventListener('click',e=>{
  const b=e.target.closest('[data-a]');if(!b)return;
  const a=b.dataset.a;
  try{
    if(a==='run'){const k=b.dataset.k;
      const sel=$('realSel');if(sel)setPref('real',sel.value);
      if(k==='all')run(GROUPS,'הכול');else if(k==='light')run(GROUPS.filter(g=>!g.heavy),'הכול בלי הכבדות');
      else{const g=GROUPS.find(x=>x.k===k);run([g],g.n);}}
    else if(a==='show'){const t=V.readText(b.dataset.p);openSheet('הדוח — '+b.dataset.n,t==null?'הקובץ לא נמצא: '+b.dataset.p:t,b.dataset.p);}
    else if(a==='report'){const p=V.saveText('דוח תוסף אבחון '+(info.version||'')+'.txt',fullReport(),true);
      if(!p){say('⚠ הדוח לא נשמר (הפרטים ביומן)',true);return;}say('נשמר בהורדות: '+p.split('/').pop());V.send(p);}
    else if(a==='preview')openSheet('דוח מלא',fullReport(),null);
    else if(a==='logm'){logMode=b.dataset.m;setPref('logMode',logMode);render();}
    else if(a==='sendlog')V.send(info.log);
    else if(a==='loose')cleanLoose(b.dataset.m);
    else if(a==='path')checkPath();
    else if(a==='pick')ask('pickFile',['בחירת קובץ לבדיקה'],v=>{if(v){$('pathIn').value=v;checkPath();}});
  }catch(err){fail(a,err);}
});
$('main').addEventListener('change',e=>{if(e.target.id==='realSel')setPref('real',e.target.value);});
$('main').addEventListener('keydown',e=>{if(e.target.id==='pathIn'&&e.key==='Enter')checkPath();});

// ---------- חלון לטקסט ארוך ----------
let shPath=null;
function openSheet(title,text,path){shPath=path;$('shT').textContent=title;$('shP').textContent=text;$('shSend').style.display=path&&ready?'':'none';
  $('shade').style.display='block';$('sheet').style.display='flex';}
function closeSheet(){$('shade').style.display='none';$('sheet').style.display='none';}
$('shX').onclick=closeSheet;$('shade').onclick=closeSheet;$('shSend').onclick=()=>{if(shPath)V.send(shPath);};
window.vfmBack=function(){if($('sheet').style.display==='flex'){closeSheet();return true;}return false;};

// ---------- הצבעים של התוכנה ----------
(function(){try{const t=J(V.theme&&V.theme(),null);if(!t)return;const r=document.documentElement.style,set=(k,v)=>{if(v)r.setProperty(k,v);};
  set('--bg',t.bg);set('--soft',t.bgSoft);set('--fg',t.text);set('--muted',t.sub);set('--ghost',t.muted);set('--chip',t.bar);
  set('--accent',t.accent);set('--err',t.red);set('--rule',t.rule);set('--on',t.onColor);}catch(e){}})();

try{collect();}catch(e){fail('קריאת התוצאה',e);}
render();

function demoBridge(){
  const store={},files={};
  const later=(id,v)=>setTimeout(()=>window.vfmResult(id,v),30);
  files['/d/log.txt']='2026-11-12 10:00:01  בניית אינדקס (בבקשה): פנימי 1.2 שנ\'\n2026-11-12 10:05:12  שגיאה ב-Lab.copy: java.io.IOException: x\n\tat a.b(c)\n2026-11-12 11:00:00  תוסף אבחון: נפתח\n';
  files['/d/trial.txt']='2026-11-10 09:12 | יומית | 0.31 שנ\' | נבדקו 4157 | נמצאו 2\n2026-11-11 09:12 | יומית | 0.30 שנ\' | נבדקו 4160 | נמצאו 0\n';
  return {info:()=>JSON.stringify({version:'מ0.42',versionCode:55,device:'גרסה מ0.42 · Samsung SM-X200 · אנדרואיד 14 (API 34)',access:true,freeMb:20480,log:'/d/log.txt',trial:'/d/trial.txt',savedMode:'עבודה',indexReady:true,lastFullBuild:Date.now()-86400000,lastDaily:Date.now()-3600000,pointsSupported:true,labVersion:'2',indexes:[{label:'פנימי',files:41230},{label:'כרטיס',files:8120}],totalFiles:49350,totalDirs:3120,lastBuilt:Date.now()-7200000,indexStatus:''}),
    theme:()=>null,load:k=>store[k]!=null?store[k]:null,save:(k,v)=>{store[k]=v;},modes:()=>JSON.stringify(['בדיקות מערכת','דוגמאות','עבודה','שמור לתוכנה']),
    dataDir:()=>'/d/אבחון',saveText:(n,t,dl)=>{const p=(dl?'/dl/':'/d/אבחון/')+n;files[p]=t;return p;},readText:p=>files[p]==null?null:files[p],
    runFile:(t,w,r)=>{window.__ran={text:t,where:w,real:r};const id=(t.match(/הרצת אבחון (\S+)/)||[])[1],rp=(t.match(/^דוח "(.*)"$/m)||[])[1];
      files[rp]='ECHO\nהרצת אבחון '+id+' · ניסוי\nשורה 3: ✅ "בדיקת פקודות" קיימת\nשורה 9: ❌ "בדיקת לחץ" — בפועל: חסרה\n✅ ודא: 51 עברו · 1 נכשלו\n';},
    pathInfo:p=>JSON.stringify({path:p,disk:true,dir:false,size:1234,index:p.indexOf('Download')>=0}),send:p=>{window.__sent=p;},
    dbStats:()=>JSON.stringify([{mode:'עבודה',kb:240,ok:true,lists:31,smarts:4,loose:2,home:9,backups:5,lastBackup:'אוטומטי 12.11.2026 18-01-02.db'},{mode:'בדיקות מערכת',kb:96,ok:true,lists:1,smarts:0,loose:0,home:0,backups:12,lastBackup:''}]),
    pickFile:(id)=>later(id,'/storage/emulated/0/Download/דוח.pdf'),toast:()=>{},log:()=>{}};
}
})();
</script>
</body>
</html>
